{
  // 本文件由 Renovate 用 JSON5 解析器读取,注释和尾逗号是合法的,
  // 编辑器按严格 JSON 报的错可以忽略(不用管黄线)。
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "rangeStrategy": "bump",
  "dependencyDashboard": false,
  "labels": ["dependencies", "renovate"],
  // automerge 只给非 major,major 升级留 PR 人工审
  "packageRules": [
    {
      // 只禁 npm 里的 node 包;Docker node 镜像和 engines/.nvmrc 照常更新
      "matchManagers": ["npm"],
      "matchDepNames": ["node"],
      "enabled": false
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    }
  ]
}
